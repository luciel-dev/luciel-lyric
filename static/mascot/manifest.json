{
  "name": "chibi-angel-mascot",
  "description": "Chibi angel: white hime-cut hair, gold halo, dark demon wings, plain white robe, front-facing, soft pink lips, yellow sparkles",
  "canvas": "1:1 square, white background (#FFFFFF), character centered",
  "idle": {
    "default": "idle/mascot-idle-512.png",
    "sizes": [
      1024,
      512,
      480,
      256,
      128
    ],
    "format": "PNG RGB"
  },
  "reactions": {
    "slow": {
      "file": "reactions/mascot-dance-slow",
      "tempo": "slow"
    },
    "mid": {
      "file": "reactions/mascot-dance-mid",
      "tempo": "mid"
    },
    "fast": {
      "file": "reactions/mascot-dance-fast",
      "tempo": "fast"
    }
  },
  "reactionSpec": {
    "resolution": "480x480",
    "fps": 24,
    "durationSec": 6.04,
    "audio": "none",
    "formats": {
      "mp4": "H.264 yuv420p faststart",
      "webm": "VP9",
      "gif": "240x240 @12fps fallback"
    }
  },
  "behavior": {
    "mode": "event-triggered only; never on a timer or schedule",
    "default": "show idle still",
    "onEvent": "play the mapped reaction exactly once, then return to idle; ignore new events while one is playing (or restart if higher priority)",
    "events": {
      "message_liked": "slow",
      "task_finished": "mid",
      "big_win": "fast"
    }
  },
